<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XrmToolBox plugin: "Team Role Manager"
    Targets .NET Framework 4.8 (XrmToolBox host requirement). If your XTB build
    still runs on 4.6.2, change TargetFramework to net462.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TeamRoleManager</AssemblyName>
    <RootNamespace>TeamRoleManager</RootNamespace>
    <!-- Keep the DLL name clean so it's easy to drop into the XTB Plugins folder -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Company>adesso</Company>
    <Product>Team Role Manager</Product>
  </PropertyGroup>

  <ItemGroup>
    <!--
      This meta-package brings in XrmToolBox.Extensibility, McTools.Xrm.Connection
      and the Dataverse/CRM SDK core assemblies (QueryExpression, IOrganizationService, ...).
      Floating "1.*" resolves the latest 1.x at restore time. Pin an exact version
      once you've confirmed the one your team standardises on.
    -->
    <PackageReference Include="XrmToolBox.Extensibility" Version="1.*" />
  </ItemGroup>

</Project>
